{
  "id": "body-scan-10",
  "voiceId": "es-elvira",
  "edgeVoice": "es-ES-ElviraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 239,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 3.096
    },
    {
      "index": 1,
      "text": "Tómese el tiempo para llegar.",
      "file": "c001.ogg",
      "durationSec": 4.224
    },
    {
      "index": 2,
      "text": "Siéntate o acuéstate con apoyo.",
      "file": "c002.ogg",
      "durationSec": 5.064
    },
    {
      "index": 3,
      "text": "Cierra los ojos si te sientes seguro.",
      "file": "c003.ogg",
      "durationSec": 5.184
    },
    {
      "index": 4,
      "text": "Siente el contacto con el suelo.",
      "file": "c004.ogg",
      "durationSec": 4.68
    },
    {
      "index": 5,
      "text": "Inhale lentamente.",
      "file": "c005.ogg",
      "durationSec": 3.696
    },
    {
      "index": 6,
      "text": "Exhale más tiempo.",
      "file": "c006.ogg",
      "durationSec": 3.696
    },
    {
      "index": 7,
      "text": "[pausa:21]",
      "file": "c007.ogg",
      "durationSec": 4.32
    },
    {
      "index": 8,
      "text": "De nuevo.",
      "file": "c008.ogg",
      "durationSec": 2.784
    },
    {
      "index": 9,
      "text": "[pausa:21]",
      "file": "c009.ogg",
      "durationSec": 4.32
    },
    {
      "index": 10,
      "text": "Deja caer los hombros.",
      "file": "c010.ogg",
      "durationSec": 4.128
    },
    {
      "index": 11,
      "text": "Deja que la barriga se ablande.",
      "file": "c011.ogg",
      "durationSec": 4.536
    },
    {
      "index": 12,
      "text": "[pausa:27]",
      "file": "c012.ogg",
      "durationSec": 4.272
    },
    {
      "index": 13,
      "text": "Comience en la coronilla de la cabeza.",
      "file": "c013.ogg",
      "durationSec": 5.016
    },
    {
      "index": 14,
      "text": "Note la sensación o la falta de ella.",
      "file": "c014.ogg",
      "durationSec": 5.736
    },
    {
      "index": 15,
      "text": "[pausa:27]",
      "file": "c015.ogg",
      "durationSec": 4.272
    },
    {
      "index": 16,
      "text": "Frente. Ojos. Mejillas. Mandíbula.",
      "file": "c016.ogg",
      "durationSec": 11.112
    },
    {
      "index": 17,
      "text": "Deja que la cara se derrita un poco.",
      "file": "c017.ogg",
      "durationSec": 4.944
    },
    {
      "index": 18,
      "text": "[pausa:27]",
      "file": "c018.ogg",
      "durationSec": 4.272
    },
    {
      "index": 19,
      "text": "Garganta. Cuello. Espalda.",
      "file": "c019.ogg",
      "durationSec": 7.968
    },
    {
      "index": 20,
      "text": "Invita a los hombros a caer.",
      "file": "c020.ogg",
      "durationSec": 4.512
    },
    {
      "index": 21,
      "text": "[pausa:32]",
      "file": "c021.ogg",
      "durationSec": 4.344
    },
    {
      "index": 22,
      "text": "Brazos. Codos. Muñecas. Manos. Dedos.",
      "file": "c022.ogg",
      "durationSec": 13.56
    },
    {
      "index": 23,
      "text": "[pausa:32]",
      "file": "c023.ogg",
      "durationSec": 4.344
    },
    {
      "index": 24,
      "text": "Pecho subiendo y bajando.",
      "file": "c024.ogg",
      "durationSec": 4.272
    },
    {
      "index": 25,
      "text": "Espacio del corazón suave.",
      "file": "c025.ogg",
      "durationSec": 4.536
    },
    {
      "index": 26,
      "text": "[pausa:27]",
      "file": "c026.ogg",
      "durationSec": 4.272
    },
    {
      "index": 27,
      "text": "Barriga. Espalda baja. Caderas.",
      "file": "c027.ogg",
      "durationSec": 8.736
    },
    {
      "index": 28,
      "text": "[pausa:32]",
      "file": "c028.ogg",
      "durationSec": 4.344
    },
    {
      "index": 29,
      "text": "Muslos. Rodillas. Terneros. Tobillos. Pies. Dedos de los pies.",
      "file": "c029.ogg",
      "durationSec": 17.376
    },
    {
      "index": 30,
      "text": "[pausa:38]",
      "file": "c030.ogg",
      "durationSec": 4.32
    },
    {
      "index": 31,
      "text": "Siente todo el cuerpo como un solo campo.",
      "file": "c031.ogg",
      "durationSec": 5.472
    },
    {
      "index": 32,
      "text": "Respiración moviéndose a través de él.",
      "file": "c032.ogg",
      "durationSec": 5.424
    },
    {
      "index": 33,
      "text": "[pausa:54]",
      "file": "c033.ogg",
      "durationSec": 4.728
    },
    {
      "index": 34,
      "text": "Si queda un lugar tenso, exhale allí.",
      "file": "c034.ogg",
      "durationSec": 5.664
    },
    {
      "index": 35,
      "text": "[pausa:43]",
      "file": "c035.ogg",
      "durationSec": 4.32
    },
    {
      "index": 36,
      "text": "Descanse en conciencia de todo el cuerpo.",
      "file": "c036.ogg",
      "durationSec": 5.568
    },
    {
      "index": 37,
      "text": "[pausa:81]",
      "file": "c037.ogg",
      "durationSec": 4.44
    },
    {
      "index": 38,
      "text": "[pausa:32]",
      "file": "c038.ogg",
      "durationSec": 4.344
    },
    {
      "index": 39,
      "text": "Comience a profundizar la respiración.",
      "file": "c039.ogg",
      "durationSec": 5.328
    },
    {
      "index": 40,
      "text": "Siente la habitación de nuevo.",
      "file": "c040.ogg",
      "durationSec": 4.512
    },
    {
      "index": 41,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c041.ogg",
      "durationSec": 5.712
    },
    {
      "index": 42,
      "text": "Cuando esté listo, abre los ojos.",
      "file": "c042.ogg",
      "durationSec": 5.184
    },
    {
      "index": 43,
      "text": "Avance lentamente hacia lo que viene a continuación.",
      "file": "c043.ogg",
      "durationSec": 6.36
    }
  ]
}
