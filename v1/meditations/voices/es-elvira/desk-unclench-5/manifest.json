  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 3.096
    },
    {
      "index": 1,
      "text": "Manténgase sentado. Esto es para la mitad del trabajo.",
      "file": "c001.ogg",
      "durationSec": 8.784
    },
    {
      "index": 2,
      "text": "Desengancha la mirada de la pantalla por un momento.",
      "file": "c002.ogg",
      "durationSec": 6.336
    },
    {
      "index": 3,
      "text": "Mira más lejos, si puedes.",
      "file": "c003.ogg",
      "durationSec": 4.752
    },
    {
      "index": 4,
      "text": "[pausa:28]",
      "file": "c004.ogg",
      "durationSec": 4.368
    },
    {
      "index": 5,
      "text": "Gire los hombros hacia arriba, hacia atrás y hacia abajo.",
      "file": "c005.ogg",
      "durationSec": 7.416
    },
    {
      "index": 6,
      "text": "Dos veces más.",
      "file": "c006.ogg",
      "durationSec": 3.48
    },
    {
      "index": 7,
      "text": "[pausa:38]",
      "file": "c007.ogg",
      "durationSec": 4.32
    },
    {
      "index": 8,
      "text": "Abre y cierra las manos.",
      "file": "c008.ogg",
      "durationSec": 4.368
    },
    {
      "index": 9,
      "text": "Agítelos ligeramente.",
      "file": "c009.ogg",
      "durationSec": 4.2
    },
    {
      "index": 10,
      "text": "[pausa:28]",
      "file": "c010.ogg",
      "durationSec": 4.368
    },
    {
      "index": 11,
      "text": "Suaviza la frente.",
      "file": "c011.ogg",
      "durationSec": 3.672
    },
    {
      "index": 12,
      "text": "Afloja la mandíbula. Deja descansar la lengua.",
      "file": "c012.ogg",
      "durationSec": 8.184
    },
    {
      "index": 13,
      "text": "[pausa:38]",
      "file": "c013.ogg",
      "durationSec": 4.32
    },
    {
      "index": 14,
      "text": "Inhala hacia los lados de las costillas.",
      "file": "c014.ogg",
      "durationSec": 5.52
    },
    {
      "index": 15,
      "text": "Exhala y deja que el pecho se asiente.",
      "file": "c015.ogg",
      "durationSec": 5.352
    },
    {
      "index": 16,
      "text": "[pausa:38]",
      "file": "c016.ogg",
      "durationSec": 4.32
    },
    {
      "index": 17,
      "text": "Parpadea lentamente tres veces.",
      "file": "c017.ogg",
      "durationSec": 5.16
    },
    {
      "index": 18,
      "text": "[pausa:28]",
      "file": "c018.ogg",
      "durationSec": 4.368
    },
    {
      "index": 19,
      "text": "Un suspiro más completo.",
      "file": "c019.ogg",
      "durationSec": 4.416
    },
    {
      "index": 20,
      "text": "Regrese cuando esté listo, un poco menos reforzado.",
      "file": "c020.ogg",
      "durationSec": 6.648
    },
    {
      "index": 21,
      "text": "[pausa:28]",
      "file": "c021.ogg",
      "durationSec": 4.368
    },
    {
      "index": 22,
      "text": "Respira tranquilamente una vez más.",
      "file": "c022.ogg",
      "durationSec": 5.544
    },
    {
      "index": 23,
      "text": "Mueve los dedos.",
      "file": "c023.ogg",
      "durationSec": 3.528
    },
    {
      "index": 24,
      "text": "Cuando estés listo, abre los ojos.",
      "file": "c024.ogg",
      "durationSec": 5.376
    },
    {
      "index": 25,
      "text": "Lleve la tranquilidad a la siguiente tarea.",
      "file": "c025.ogg",
      "durationSec": 5.376
    }
  ]
}
