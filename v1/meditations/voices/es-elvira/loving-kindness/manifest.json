  "chunks": [
    {
      "index": 0,
      "text": "Siéntate cómodamente. Suaviza el rostro.",
      "file": "c000.ogg",
      "durationSec": 7.824
    },
    {
      "index": 1,
      "text": "Coloque una mano sobre el corazón si eso ayuda.",
      "file": "c001.ogg",
      "durationSec": 6.192
    },
    {
      "index": 2,
      "text": "Ofreceremos frases sencillas de bondad.",
      "file": "c002.ogg",
      "durationSec": 5.328
    },
    {
      "index": 3,
      "text": "Primero, hacia ti mismo.",
      "file": "c003.ogg",
      "durationSec": 4.224
    },
    {
      "index": 4,
      "text": "Repite en silencio conmigo o simplemente escucha.",
      "file": "c004.ogg",
      "durationSec": 6.552
    },
    {
      "index": 5,
      "text": "¿Puedo estar a salvo?",
      "file": "c005.ogg",
      "durationSec": 3.72
    },
    {
      "index": 6,
      "text": "Que esté bien.",
      "file": "c006.ogg",
      "durationSec": 3.048
    },
    {
      "index": 7,
      "text": "Que pueda estar tranquilo.",
      "file": "c007.ogg",
      "durationSec": 4.104
    },
    {
      "index": 8,
      "text": "Dígalas de nuevo, lentamente.",
      "file": "c008.ogg",
      "durationSec": 4.68
    },
    {
      "index": 9,
      "text": "¿Puedo estar a salvo?",
      "file": "c009.ogg",
      "durationSec": 3.72
    },
    {
      "index": 10,
      "text": "Que esté bien.",
      "file": "c010.ogg",
      "durationSec": 3.048
    },
    {
      "index": 11,
      "text": "Que pueda estar tranquilo.",
      "file": "c011.ogg",
      "durationSec": 4.104
    },
    {
      "index": 12,
      "text": "Si eso le resulta difícil, está bien. Quédate con el deseo mismo.",
      "file": "c012.ogg",
      "durationSec": 9.84
    },
    {
      "index": 13,
      "text": "Ahora piense en alguien por quien sea fácil preocuparse.",
      "file": "c013.ogg",
      "durationSec": 6.816
    },
    {
      "index": 14,
      "text": "Un amigo, una mascota, un amable extraño.",
      "file": "c014.ogg",
      "durationSec": 6.264
    },
    {
      "index": 15,
      "text": "Imagínelos brevemente.",
      "file": "c015.ogg",
      "durationSec": 4.248
    },
    {
      "index": 16,
      "text": "Que estés a salvo.",
      "file": "c016.ogg",
      "durationSec": 3.576
    },
    {
      "index": 17,
      "text": "Que estés bien.",
      "file": "c017.ogg",
      "durationSec": 3.288
    },
    {
      "index": 18,
      "text": "Que estés tranquilo.",
      "file": "c018.ogg",
      "durationSec": 3.624
    },
    {
      "index": 19,
      "text": "Una vez más.",
      "file": "c019.ogg",
      "durationSec": 3.216
    },
    {
      "index": 20,
      "text": "Que estés a salvo.",
      "file": "c020.ogg",
      "durationSec": 3.576
    },
    {
      "index": 21,
      "text": "Que estés bien.",
